{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=kitatolongkita;Username=postgres;Password=postgres123"
  },
  "ElasticSearch": {
    "Url": "http://localhost:9200"
  },
  "Jwt": {
    "Secret": "KitaTolongKita_SuperSecretKey_MinLength32Chars!",
    "Issuer": "KitaTolongKita",
    "Audience": "KitaTolongKitaApp",
    "AccessTokenExpiryMinutes": "60"
  },
  "App": {
    "Port": "5000"
  },
  "AI": {
    "Provider": "azure-openai",
    "ApiKey": "YOUR-API-KEY-HERE",
    "Endpoint": "https://YOUR-RESOURCE.openai.azure.com",
    "DeploymentName": "gpt-4o",
    "Model": "gpt-4o",
    "AutoApproveThreshold": "80",
    "PendingReviewThreshold": "50"
  }
}
