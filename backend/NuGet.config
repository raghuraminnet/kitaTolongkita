<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-level NuGet.config for the KitaTolongKita backend.

  The user's global %APPDATA%\NuGet\NuGet.Config on Windows registers several
  local package sources (MySQL Connector, Visual Studio Offline Packages, the
  VS Shared fallback folder at "C:\Program Files (x86)\Microsoft Visual
  Studio\Shared\NuGetPackages"). Inside the Linux Docker build container those
  paths don't exist, so `dotnet publish` crashes with:

      Unable to find fallback package folder 'C:\Program Files (x86)\Microsoft
      Visual Studio\Shared\NuGetPackages'.

  This file overrides the global config so the build only uses nuget.org and
  has no fallback folders.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

  <config>
    <!-- Use a container-local packages folder so restore output stays inside the image. -->
    <add key="globalPackagesFolder" value="/root/.nuget/packages" />
  </config>
</configuration>
